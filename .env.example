# Copy to .env. AWS credentials are taken from the standard boto3 chain (~/.aws, env vars).
NHL_S3_BUCKET=tmw-nhl-data
NHL_S3_REGION=us-east-2
# Local read-through cache for S3 objects (defaults to ./data/cache)
# NHL_CACHE_DIR=
# Max NHL API requests per second across all worker threads
# NHL_API_RPS=8
# 4Casters exchange account (the order book needs sign-in since 2026-10-06; without it the
# 4Casters source is skipped). The session token is cached under the cache directory.
# CAST4_USER=
# CAST4_PASS=
