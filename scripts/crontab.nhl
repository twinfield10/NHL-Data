# BEGIN NHL-Data (managed by scripts/install_cron.sh; edit scripts/crontab.nhl, not crontab -e)
# Times are local = America/New_York. Every minute below avoids multiples of 5, which other
# jobs on this machine already use. Why each job runs when it does: docs/scheduler.md.
#
# Nightly rebuild after the last West Coast games are final, before the 05:35-07:15 cluster.
19 4 * * *                      /Users/tommywinfield/GitRepos/NHL-Data/scripts/nightly.sh >> /Users/tommywinfield/GitRepos/NHL-Data/logs/nightly.log 2>&1
# Morning slate: first pregame run of the day, whether or not anything changed.
14 9 * * *                      /Users/tommywinfield/GitRepos/NHL-Data/scripts/pregame.sh >> /Users/tommywinfield/GitRepos/NHL-Data/logs/pregame.log 2>&1
# Lineup news (DFO goalies, ESPN injuries, transactions, referees): every 15 min 08-23 on game days...
7,22,37,52 8-23 * * *           /Users/tommywinfield/GitRepos/NHL-Data/scripts/poll.sh goalies,injuries,transactions,officials --window 960 --reprice >> /Users/tommywinfield/GitRepos/NHL-Data/logs/poll_lineups.log 2>&1
# ...and every 5 min within 90 min of a puck drop (confirmed starters, right-rail officials).
2,12,17,27,32,42,47,57 * * * *  /Users/tommywinfield/GitRepos/NHL-Data/scripts/poll.sh goalies,injuries,transactions,officials --window 90 --reprice >> /Users/tommywinfield/GitRepos/NHL-Data/logs/poll_lineups.log 2>&1
# DailyFaceoff line combinations (32 pages, ~65 s): hourly on game days, 3x/hour near puck drop.
11 8-23 * * *                   /Users/tommywinfield/GitRepos/NHL-Data/scripts/poll.sh lines --window 960 --reprice >> /Users/tommywinfield/GitRepos/NHL-Data/logs/poll_lines.log 2>&1
26,41,56 * * * *                /Users/tommywinfield/GitRepos/NHL-Data/scripts/poll.sh lines --window 90 --reprice >> /Users/tommywinfield/GitRepos/NHL-Data/logs/poll_lines.log 2>&1
# Odds (LowVig, 4Casters, ESPN books): every 15 min when a game is within 24 h (opens)...
3,18,33,48 * * * *              /Users/tommywinfield/GitRepos/NHL-Data/scripts/poll.sh odds --window 1440 >> /Users/tommywinfield/GitRepos/NHL-Data/logs/poll_odds.log 2>&1
# ...and every 5 min within 90 min of a puck drop (the closing line).
8,13,23,28,38,43,53,58 * * * *  /Users/tommywinfield/GitRepos/NHL-Data/scripts/poll.sh odds --window 90 >> /Users/tommywinfield/GitRepos/NHL-Data/logs/poll_odds.log 2>&1
# END NHL-Data
