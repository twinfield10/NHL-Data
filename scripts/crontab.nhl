# BEGIN NHL-Data (managed by scripts/install_cron.sh; edit scripts/crontab.nhl, not crontab -e)
# Times are local = America/New_York. Every minute below avoids multiples of 5, which other
# jobs on this machine already use. Why each job runs when it does: docs/scheduler.md.
#
# Nightly rebuild after the last West Coast games are final, before the 05:35-07:15 cluster;
# it ends by pricing every date in the horizon (this replaced the 09:14 slate run).
19 4 * * *                      /Users/tommywinfield/GitRepos/NHL-Data/scripts/nightly.sh >> /Users/tommywinfield/GitRepos/NHL-Data/logs/nightly.log 2>&1
# Lineup news (DFO goalies, ESPN injuries, transactions, referees): every 15 min 08-23 on game days...
7,22,37,52 8-23 * * *           /Users/tommywinfield/GitRepos/NHL-Data/scripts/poll.sh goalies,injuries,transactions,officials --window 960 --reprice --edges >> /Users/tommywinfield/GitRepos/NHL-Data/logs/poll_lineups.log 2>&1
# ...and every 5 min within 90 min of a puck drop (confirmed starters, right-rail officials).
2,12,17,27,32,42,47,57 * * * *  /Users/tommywinfield/GitRepos/NHL-Data/scripts/poll.sh goalies,injuries,transactions,officials --window 90 --reprice --edges >> /Users/tommywinfield/GitRepos/NHL-Data/logs/poll_lineups.log 2>&1
# DailyFaceoff line combinations (32 pages, ~65 s): hourly on game days, 3x/hour near puck drop.
11 8-23 * * *                   /Users/tommywinfield/GitRepos/NHL-Data/scripts/poll.sh lines --window 960 --reprice --edges >> /Users/tommywinfield/GitRepos/NHL-Data/logs/poll_lines.log 2>&1
26,41,56 * * * *                /Users/tommywinfield/GitRepos/NHL-Data/scripts/poll.sh lines --window 90 --reprice --edges >> /Users/tommywinfield/GitRepos/NHL-Data/logs/poll_lines.log 2>&1
# Odds (LowVig, 4Casters, ESPN books incl. DraftKings props), FanDuel props and Novig (lines + props, one websocket
# snapshot): hourly at :03 when a game is within 72 h, so openers posted ~30-53 h ahead are caught (and priced)
# even on off days...
3 * * * *                       /Users/tommywinfield/GitRepos/NHL-Data/scripts/poll.sh odds,props,novig --window 4320 --edges >> /Users/tommywinfield/GitRepos/NHL-Data/logs/poll_odds.log 2>&1
# ...every 15 min when a game is within 24 h (with the :03 run above)...
18,33,48 * * * *                /Users/tommywinfield/GitRepos/NHL-Data/scripts/poll.sh odds,props,novig --window 1440 --edges >> /Users/tommywinfield/GitRepos/NHL-Data/logs/poll_odds.log 2>&1
# ...and every 5 min within 90 min of a puck drop (the closing line, every book on the same poll).
8,13,23,28,38,43,53,58 * * * *  /Users/tommywinfield/GitRepos/NHL-Data/scripts/poll.sh odds,props,novig --window 90 --edges >> /Users/tommywinfield/GitRepos/NHL-Data/logs/poll_odds.log 2>&1
# LowVig/BetOnline props (headless-browser walk, ~75 s): every 15 min 09-23 on game days...
4,19,34,49 9-23 * * *           /Users/tommywinfield/GitRepos/NHL-Data/scripts/poll.sh props_lowvig --window 960 --edges >> /Users/tommywinfield/GitRepos/NHL-Data/logs/poll_props.log 2>&1
# ...and in between within 90 min of a puck drop (about every 7 min with the above).
9,24,39,54 * * * *              /Users/tommywinfield/GitRepos/NHL-Data/scripts/poll.sh props_lowvig --window 90 --edges >> /Users/tommywinfield/GitRepos/NHL-Data/logs/poll_props.log 2>&1
# END NHL-Data
